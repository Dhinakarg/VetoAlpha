# ============================================================
# ALPACA TRADING API CONFIGURATION (PAPER TRADING ONLY)
# ============================================================
ALPACA_API_KEY=your_alpaca_paper_api_key_here
ALPACA_SECRET_KEY=your_alpaca_paper_secret_key_here
ALPACA_PAPER=true

# ============================================================
# OPENAI-COMPATIBLE LLM PROVIDER CONFIGURATION
# Set your preferred provider below (Featherless, OpenAI, Gemini, Groq, OpenRouter, Ollama)
# ============================================================
LLM_API_KEY=your_llm_provider_api_key_here
LLM_BASE_URL=https://api.featherless.ai/v1
LLM_MODEL=deepseek-ai/DeepSeek-V4-Flash-0731

# ------------------------------------------------------------
# PROVIDER PRESET EXAMPLES (Copy into LLM_BASE_URL & LLM_MODEL above):
# ------------------------------------------------------------
# 1. Featherless AI (Default):
#    LLM_BASE_URL=https://api.featherless.ai/v1
#    LLM_MODEL=deepseek-ai/DeepSeek-V4-Flash-0731
#
# 2. OpenAI:
#    LLM_BASE_URL=https://api.openai.com/v1
#    LLM_MODEL=gpt-4o-mini
#
# 3. Google Gemini (OpenAI Compatibility Mode):
#    LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#    LLM_MODEL=gemini-1.5-flash
#
# 4. Groq:
#    LLM_BASE_URL=https://api.groq.com/openai/v1
#    LLM_MODEL=llama-3.1-70b-versatile
#
# 5. OpenRouter:
#    LLM_BASE_URL=https://openrouter.ai/api/v1
#    LLM_MODEL=meta-llama/llama-3.1-8b-instruct
#
# 6. Local Ollama / vLLM (Zero API Cost):
#    LLM_BASE_URL=http://localhost:11434/v1
#    LLM_MODEL=llama3
# ------------------------------------------------------------

# Legacy environment variable aliases (Supported for backward compatibility)
FEATHERLESS_API_KEY=your_llm_provider_api_key_here
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1
FEATHERLESS_MODEL=deepseek-ai/DeepSeek-V4-Flash-0731
